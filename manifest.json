{
  "manifest_version": 3,
  "name": "LeetCode Premium Redirector",
  "version": "1.0",
  "description": "Automatically redirects premium LeetCode problems to leetcode.ca.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://leetcode.com/problems/*",
    "https://leetcode.ca/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://leetcode.com/problems/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}